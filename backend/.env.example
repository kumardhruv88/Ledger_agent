# Groq API Key for blazing fast LLM inference (A2, A4, A6, A7)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (optional fallback or for specific tasks)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URI (for the A8 Meta-Agent Observability Telemetry)
# Examples: sqlite:///./ledger_telemetry.db OR postgresql://user:pass@localhost/dbname
DATABASE_URL=sqlite:///./ledger_telemetry.db
